# Vite dev-server proxy target: the Laravel API.
#
# The browser only ever talks to the Vite dev server (http://localhost:5173);
# Vite forwards /api and /sanctum to Laravel. The app is therefore same-origin,
# the Sanctum SPA cookies stay first-party, and SANCTUM_STATEFUL_DOMAINS
# (localhost:5173) keeps working without any CORS dance.
VITE_PROXY_TARGET=http://localhost:8000
