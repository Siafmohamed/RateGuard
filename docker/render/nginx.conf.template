# Rendered to /etc/nginx/conf.d/default.conf by the entrypoint, which substitutes
# $PORT and nothing else (see docker/render/entrypoint.sh). Everything else -
# $uri, $document_root, $fastcgi_script_name - has to survive verbatim.

server {
    listen ${PORT};
    server_name _;

    root /var/www/html/public;
    index index.php index.html;

    charset utf-8;

    # Carrier invoices are capped at 5 MB client-side; this leaves room for the
    # multipart envelope.
    client_max_body_size 6M;

    # Render captures the container's stdout/stderr, so nginx must not log to
    # files: the filesystem is ephemeral and those files would never be visible.
    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    # /blog, /docs, /sitemap.xml and /robots.txt have no matching file under
    # public/, so they fall through to Laravel here. /robots.txt is deliberately
    # NOT served as a static file: Laravel owns it so the Sitemap line always
    # points at config('app.url').
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }

    # Static assets of the built SPA, baked into the image at /var/www/spa.
    # Vite emits content-hashed bundles under /assets/, so the filename changes
    # whenever the content does: cache them for a year.
    location /assets/ {
        root /var/www/spa;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Not hashed, so a much shorter cache.
    location = /favicon.svg {
        root /var/www/spa;
        access_log off;
        add_header Cache-Control "public, max-age=3600";
    }

    error_page 404 /index.php;

    location ~ \.php$ {
        # php-fpm shares this container, so it is reached over the loopback
        # interface rather than a Compose service name.
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        include fastcgi_params;

        # Render terminates TLS at its edge and forwards plain HTTP. Without this
        # the application would treat the request as insecure, which matters for
        # Sanctum's secure session cookie.
        fastcgi_param HTTPS on;

        fastcgi_read_timeout 300;

        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
