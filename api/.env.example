APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
INVOICE_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Content gateway (headless WordPress) ----------------------------------
# Internal URL of the WordPress service (Compose service name on the shared
# network). Never exposed to the browser; Laravel is the only caller.
WP_BASE_URL=http://wordpress
WP_USER=
WP_APP_PASSWORD=
WP_TIMEOUT=3
WP_CONNECT_TIMEOUT=2
WP_RETRIES=2
WP_RETRY_DELAY_MS=200
WP_FRESH_TTL=300
WP_STALE_TTL=86400
WP_CIRCUIT_THRESHOLD=5
WP_CIRCUIT_COOLDOWN=30

# --- WordPress database (post import) --------------------------------------
# Read-only source used ONLY by `php artisan rateguard:sync-posts`, which copies
# published wp_posts into the local `posts` table. The blog is then served from
# Laravel's own database, so WordPress is never queried at request time.
# These must match the WP_DB_* values used by the wordpress_db service in
# docker-compose.yml; the host is a Compose service name, not localhost.
WP_DB_HOST=wordpress_db
WP_DB_PORT=3306
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=secret
# WordPress' default table prefix (tables are wp_posts, wp_postmeta, ...).
WP_DB_PREFIX=wp_

# --- SEO shell (SPA bootstrap) ---------------------------------------------
# Absolute path to the BUILT React index.html. Laravel injects the SEO head
# tags and initial data into it. Leave SPA_INDEX_PATH empty (or point it at a
# file that does not exist yet) during development: Laravel then falls back to
# a minimal Blade shell that loads the Vite dev server below.
SPA_INDEX_PATH=
SPA_DEV_URL=http://localhost:5173/src/main.tsx

VITE_APP_NAME="${APP_NAME}"
